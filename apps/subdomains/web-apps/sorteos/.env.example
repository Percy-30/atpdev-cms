# Sorteos Pro — variables de entorno (copiar a .env.local)
NEXT_PUBLIC_APP_URL=http://localhost:3006

# Auth / cifrado (obligatorias en producción)
SORTEOS_JWT_SECRET=cambia-esto-min-32-chars
SORTEOS_TOKEN_KEY=cambia-esto-32-bytes-exactos-00

# Cron protegido (obligatorio en producción)
CRON_SECRET=cambia-esto

# Email transaccional (opcional: sin esto, modo mock-outbox + /api/v1/admin/emails)
RESEND_API_KEY=
RESEND_FROM=Sorteos Pro <noreply@sorteos.pro>

# Facturación Stripe (opcional: sin esto, checkout mock-verified)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_ANNUAL=

# Sociales (opcional: sin esto, fetch mock-verified + OAuth mock)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=
