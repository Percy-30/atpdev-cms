{
  "name": "atpdev-monorepo",
  "private": true,
  "packageManager": "npm@11.6.1",
  "workspaces": [
    "apps/core/*",
    "apps/subdomains/*/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=apps/core/portal && npm run build --workspace=apps/core/admin",
    "build:portal": "npm run build --workspace=apps/core/portal",
    "build:admin": "npm run build --workspace=apps/core/admin",
    "dev": "turbo run dev",
    "dev:portal": "npm run dev --workspace=apps/core/portal -- -p 3000",
    "dev:admin": "npm run dev --workspace=apps/core/admin -- -p 3001",
    "lint": "npm run lint --workspace=apps/core/portal && npm run lint --workspace=apps/core/admin",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "lightningcss": "^1.33.0",
    "prettier": "^3.2.5",
    "turbo": "^2.10.9"
  }
}
